# Fallos esperados (XFAIL): un id por línea. Cada entrada se ELIMINA en el
# mismo commit que aterriza su fix (el XPASS resultante lo recuerda).
# Formatos: unit:<binario> | invariants:<check> | script:<id>
invariants:sum_alpha
# T_gas runaway estructural post-C1.7: el inventario del gas ideal
# (rho(T)*cp*T = const) no acumula energía y no hay enfriamiento radiativo
# real (S_RAD_LIMIT neutraliza el DO) ni salida de entalpía -> fix C3.4
invariants:T_gas_bound
# lag de interfaz TDMA/SOR amplificado por el runaway de T_gas (solo
# T_gas/uz_gas difieren; sólido/líquido/presión/especies son idénticos);
# re-medir tras C3.4
script:decomposition_cold_n1
script:decomposition_cold_n4
# melt requiere C1.8 (energía de fusión): el líquido recién fundido se
# recongela por el crash de T_s (cp_s vs cp_eff)
script:melt
# energy_balance: el inventario del gas ideal no acumula (ver T_gas_bound);
# arc_budget: ~0.95 por celdas triviales/beams que escapan (afinar en C3.4);
# mass_liq hasta C1.8
audit:energy_balance
audit:arc_budget
audit:mass_liq
