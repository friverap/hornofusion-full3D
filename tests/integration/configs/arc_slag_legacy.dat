# Banco arc_slag_legacy (auditoria 18, A18-9): arc_slag con la escoria en el
# camino LEGADO (slag_in_volume = false: capa fuera del Poisson, cesion en el
# derrame, slag_buoyancy cada paso). Tras el Plan H ningun banco lo ejercia.
nr = 12
ntheta = 24
stretch_r = 1.0
stretch_z = 1.0
dt = 0.01
