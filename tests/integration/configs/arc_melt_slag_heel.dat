solve_flow = true
solve_energy = true
solve_melting = true
solve_turb = false
solve_radiation = true
solve_chemistry = false
solve_arc = true
solve_multiphase = true
alpha_p = 0.3
max_outer = 5
max_inner_mom = 3
max_inner_pres = 200
audit_freq = 1
output_freq = 10
monitor_freq = 50
solve_slag = true
m_slag_init = 500.0
