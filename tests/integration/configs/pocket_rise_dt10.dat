# Banco pocket_rise_dt10 (auditoria 8, M8-2): pocket_rise con dt = 10 ms (el
# reinicio usa el dt del SNAPSHOT: make_pocket_init.py --dt 0.01). Con la
# movilidad de F2.16 evaluada al dt de la corrida, la capa saturada cortaba el
# camino del gas con dt >= ~6.5 ms y la bolsa quedaba pared (sin subir, gas a
# 131 m/s); con DT_MOB_REF sube igual que con 5 ms. Resto: ver pocket_rise.dat.
nr = 12
ntheta = 24
nz = 16
stretch_r = 1.0
stretch_z = 1.0
charge_recipe_file = input/recipe_bed_flood.dat
dt = 0.01
t_final = 0.5
adaptive_dt = false
heel_mass = 100000.0
heel_T = 1850.0
T_initial = 1850.0
T_ambient = 1850.0
solve_flow = true
solve_energy = true
solve_melting = false
solve_turb = false
solve_radiation = false
solve_chemistry = false
solve_arc = false
solve_multiphase = true
alpha_p = 0.3
max_outer = 20
max_inner_mom = 3
max_inner_pres = 200
audit_freq = 1
output_freq = 1
monitor_freq = 20
