# Banco pocket_rise (auditoria 6-7, M4-12): BOLSA de gas bajo una capa saturada
# del lecho. Reanuda desde un estado construido (make_pocket_init.py sobre el
# paso 0 de bed_bath_rest_n4; el harness agrega restart_file): capa 8
# saturada, capas 6-7 con gas, sin camino al freeboard, presion HIDROSTATICA
# de la nueva estratificacion y rho_gas coherente. Con los defaults el gas
# sube a contracorriente desde el primer paso. (La retencion de 0.25-0.3 s
# medida en la auditoria 6 era el estado construido con la presion del
# snapshot de origen, no el modelo.) El estado no es punto fijo: la capa
# saturada drena y la bolsa se despresuriza y ventea. (El pico de u_gas, 45
# m/s, es un modo par-impar del freeboard del lazo truncado a max_outer 5, no
# el venteo.) Criterio: check_pocket.py, que juzga la presion
# de la bolsa frente a la capa 9 (auditoria 8, M8-3; por eso output_freq 2).
nr = 12
ntheta = 24
nz = 16
stretch_r = 1.0
stretch_z = 1.0
charge_recipe_file = input/recipe_bed_flood.dat
dt = 0.005
t_final = 0.5
adaptive_dt = false
heel_mass = 100000.0
heel_T = 1850.0
T_initial = 1850.0
T_ambient = 1850.0
solve_flow = true
solve_energy = true
solve_melting = false
solve_turb = false
solve_radiation = false
solve_chemistry = false
solve_arc = false
solve_multiphase = true
alpha_p = 0.3
max_outer = 5
max_inner_mom = 3
max_inner_pres = 200
audit_freq = 1
output_freq = 2
monitor_freq = 20
