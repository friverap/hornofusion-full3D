# Banco ecs_slag (Plan I, I2; auditoria general 2 del Plan I, M2): carga
# continua ECS sobre un baño de 274 t con una capa GRUESA de escoria
# condensada (60 t: acero hasta ~41 % de k5, escoria en el resto de k5, k6
# LLENA y ~9 % de k7: la celda k0 = 6 no tiene gas y la chatarra tiene que
# desplazar escoria; con 40 t k6 tenia 47 % de gas y la chatarra nunca la
# tocaba, dirigida general 2 A1). 20 kg/paso: la superficie sube un nivel
# cada ~22 pasos (alpha_s > 0.05), sin llegar al techo en 0.6 s. Con
# slag_in_volume la chatarra ATRAVIESA la escoria: se apoya en el tope del
# acero y slag_condensed_sort sube la escoria desplazada. Isotermo, sin
# arco, fusion, radiacion ni quimica: el solido solo cambia por la carga y el
# contacto escoria-chatarra (check_ecs.py --slag). nz = 16 para que n12
# (2x3x2) corte r (indice global de la banda, M38) y n9 (1x3x3) corte z
# dentro de la escoria. MEDIDO (21-oct, golden v129; PLAN_I gates 5-8):
# masa/energia del ECS a 1e-16, 16 columnas con base k0 y desplazamiento;
# descomposicion 1.4e-6 (n9) / 6.0e-6 (n12) en velocidades.
nr = 12
ntheta = 24
nz = 16
stretch_r = 1.0
stretch_z = 1.0
dt = 0.01
t_final = 0.6
adaptive_dt = false
charge_bucket1 = false
t_bucket2_charge = 1.0e30
heel_mass = 274000.0
heel_T = 1850.0
T_initial = 1850.0
T_ambient = 1850.0
solve_flow = true
solve_energy = true
solve_melting = false
solve_turb = false
solve_radiation = false
solve_chemistry = false
solve_arc = false
solve_multiphase = true
alpha_p = 0.7
max_outer = 10
max_inner_mom = 3
max_inner_pres = 400
audit_freq = 1
output_freq = 10
monitor_freq = 10
solve_slag = true
slag_in_volume = true
m_slag_init = 60000.0
solve_ecs = true
ecs_rate = 2.0e3
ecs_theta_center = 0.0
ecs_theta_width = 0.8
ecs_r_inner = 2.4
ecs_vfrac = 0.55
ecs_T_charge = 1500.0
ecs_carbon_frac = 0.008
