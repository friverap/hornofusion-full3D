# Banco arc_slag (auditoria 12; modelo termico de la escoria oct-2026):
# arc_noscrap en malla FINA (nz 64, dz ~0.07 m) con 10 t de escoria en su
# PROPIA capa sobre el bano, como en la malla de produccion. Ejerce: el arco
# con cavidad (P_elec/P_conv al metal; la escoria intercepta solo la
# radiacion del MC), la escoria densa en la DO, su acople con el bano y la
# escoria que CEDE al acero (el exceso bajo la interfaz entra en su celda:
# sin la cesion su alpha_clip estricto falla, 9.5e-5 kg). n1 frente a n4:
# invarianza MPI de la cesion. Medido a 10 s: T_sl max bajo T_l max, clip
# ~1e-9 kg. max_inner_pres 400: con 200 el CG no converge en esta malla fina.
nr = 12
ntheta = 24
stretch_r = 1.0
stretch_z = 1.0
dt = 0.01
adaptive_dt = false
charge_bucket1 = false
heel_mass = 274000.0
heel_T = 1850.0
T_initial = 1850.0
solve_flow = true
solve_energy = true
solve_melting = false
solve_turb = false
solve_radiation = true
solve_chemistry = false
solve_arc = true
solve_multiphase = true
alpha_p = 0.7
max_outer = 10
max_inner_mom = 3
max_inner_pres = 400
audit_freq = 1
output_freq = 5
monitor_freq = 5

nz = 64
solve_slag = true
m_slag_init = 10000.0
t_final = 0.05
