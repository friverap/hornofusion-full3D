# Banco arc_slag (auditoria 12, M12-1arc): arc_noscrap en malla FINA (nz 64,
# dz ~0.07 m) con 10 t de escoria, que ocupa su PROPIA capa sobre el bano, como
# en la malla de produccion. Cubre el LIMITE vigente: el arco y el MC ven solo
# alpha_l, saltan la capa de escoria y depositan en el bano de debajo (la
# escoria intercepta solo lo de su celda: E_slag_intercept 0.94 MJ de ~2.2 MJ).
# Hacer de la escoria superficie (alpha_l + alpha_sl) se probo y NO se adopto:
# la escoria se lleva casi todo el arco y no tiene salida de calor (no emite en
# la DO, sin transporte lateral, acople con el bano de cientos de J por paso):
# miles de K en decenas de segundos en produccion. Requiere antes un modelo
# termico de la escoria. alpha_clip es xfail con causa: la interfaz de escoria
# corta el relevo del derrame (A11-2 con escoria). max_inner_pres 400: con 200
# el CG no converge en esta malla fina.
nr = 12
ntheta = 24
stretch_r = 1.0
stretch_z = 1.0
dt = 0.01
adaptive_dt = false
charge_bucket1 = false
heel_mass = 274000.0
heel_T = 1850.0
T_initial = 1850.0
solve_flow = true
solve_energy = true
solve_melting = false
solve_turb = false
solve_radiation = true
solve_chemistry = false
solve_arc = true
solve_multiphase = true
alpha_p = 0.7
max_outer = 10
max_inner_mom = 3
max_inner_pres = 400
audit_freq = 1
output_freq = 5
monitor_freq = 5

nz = 64
solve_slag = true
m_slag_init = 10000.0
t_final = 0.05
