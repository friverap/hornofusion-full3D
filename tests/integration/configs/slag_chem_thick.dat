# Banco slag_chem_thick (auditoria 18, A1): quimica de escoria con una capa
# CONDENSADA GRUESA (10 t sobre el baño de arc_slag, malla fina nz 64: varias
# celdas de escoria compactadas, sin gas). Vigila que la REDUCCION FeO + C
# no quede bloqueada por el hueco (antes solo reducia la celda tope con gas:
# 0.35 kg de Fe devuelto en 0.3 s frente a 0.67 con el hueco que libera la
# propia escoria reducida). check_slag_chem --min-return.
nr = 12
ntheta = 24
stretch_r = 1.0
stretch_z = 1.0
dt = 0.01
adaptive_dt = false
charge_bucket1 = false
heel_mass = 274000.0
heel_T = 1850.0
T_initial = 1850.0
solve_flow = true
solve_energy = true
solve_melting = false
solve_turb = false
solve_radiation = true
solve_chemistry = false
solve_arc = true
solve_multiphase = true
alpha_p = 0.7
max_outer = 10
max_inner_mom = 3
max_inner_pres = 400
audit_freq = 1
monitor_freq = 5

nz = 64
solve_slag = true
m_slag_init = 10000.0
solve_chemistry = true
solve_species = true
slag_x_feo_init = 0.25
slag_x_cao_init = 0.35
slag_x_sio2_init = 0.16
slag_x_mgo_init = 0.08
slag_eta_feo = 0.3
carbon_inj_rate = 0.5
carbon_frac = 0.0
t_final = 0.3
output_freq = 30
