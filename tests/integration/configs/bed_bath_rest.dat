# Banco bed_bath_rest (auditoria 4, A4-7): BANO BAJO LECHO en reposo. Heel de
# 100 t que satura los poros de un lecho frio (receta bed_flood), sin arco ni
# fusion, gas y paredes en equilibrio termico. Es el estado de B1 a ~300 s que
# ningun banco ejercia con la fuerza balanceada (bed_flood corre con
# pc_fs_liquid_gradient, que la apaga). Criterios en check_bedbath.py.
# Hallazgo que destapo (A4-1): con mascaras de flotacion distintas por fase el
# liquido del poro saturado se movia a 0.29 m/s en reposo.
nr = 12
ntheta = 24
nz = 16
stretch_r = 1.0
stretch_z = 1.0
charge_recipe_file = input/recipe_bed_flood.dat
dt = 0.005
t_final = 0.5
adaptive_dt = false
heel_mass = 100000.0
heel_T = 1850.0
T_initial = 1850.0
T_ambient = 1850.0
solve_flow = true
solve_energy = true
solve_melting = false
solve_turb = false
solve_radiation = false
solve_chemistry = false
solve_arc = false
solve_multiphase = true
alpha_p = 0.3
max_outer = 5
max_inner_mom = 3
max_inner_pres = 200
audit_freq = 1
output_freq = 10
monitor_freq = 20
