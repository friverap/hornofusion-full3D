# (WS-K9) flujo frio de dos fluidos SIN energia: m_gas_out debe acumularse
# igual (mass_gas_flux_closure, panel WS-K8 auditor B1). cold_10step con
# solve_energy, solve_melting, solve_radiation y solve_arc apagados.
# Test de regresión frío: 10 pasos, malla pequeña, física de flujo completa.
# Equivale a input/config_small_test.dat pero con dt fijo (determinismo).
# mdot = 0 en toda la corrida (T inicial = 300 K): NO cubre fusión.
# El runner añade output_dir al final (la última clave gana).
nr = 12
ntheta = 24
nz = 16
stretch_r = 1.0
stretch_z = 1.0

# dt CFL-sano (~2 con u_gas~5 m/s y dtheta*r~0.04 m): con el gas activo
# en el Poisson (low-Mach 2026), dt=0.5 era CFL~400 — regimen caotico no
# testeable por invarianza.
dt = 0.02
t_final = 0.2
adaptive_dt = false

solve_flow = true
solve_energy = false
solve_melting = false
solve_turb = true
solve_radiation = false
solve_chemistry = false
solve_arc = false
solve_multiphase = true

# (auditoria 6, M6-1) lazo de PRODUCCION (10): con la cota de compresibilidad
# medida contra el gas que atraviesa la celda, la demanda que antes se
# recortaba ahora se pide y con 5 iteraciones el encendido quedaba truncado
# (energy_balance 0.97 de lo permitido; con 40 cierra a 0.8 J, con 10 a 0.03)
max_outer = 10
max_inner_mom = 3
max_inner_pres = 200  # Poisson de dominio completo con el gas (low-Mach)

output_freq = 5
monitor_freq = 5
