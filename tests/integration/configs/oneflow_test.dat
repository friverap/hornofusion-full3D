solve_flow = true
solve_energy = true
solve_melting = false
solve_turb = false
solve_radiation = false
solve_chemistry = false
solve_arc = false
solve_multiphase = false
alpha_p = 0.7
max_outer = 10
max_inner_mom = 3
max_inner_pres = 200
audit_freq = 1
output_freq = 10
monitor_freq = 10
