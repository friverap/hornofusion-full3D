+def juzgada(pid, ev):
+    """La prediccion `pid` tiene veredicto, directo o sobre una de sus enmiendas."""
+    refs = {pid} | {x["id"] for x in ev if x.get("tipo") == "enmienda" and x.get("ref") == pid}
+    return any(x.get("tipo") == "veredicto" and x.get("ref") in refs for x in ev)
