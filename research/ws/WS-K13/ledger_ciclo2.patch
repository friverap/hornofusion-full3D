+
+def estado_enmienda(eid, ev):
+    """Estado que una enmienda transmite a su prediccion: el de su ultimo veredicto o
+    sub-enmienda (recursivo); 'enmendada' si nadie la juzgo. Otros eventos que la citen
+    (notas, resultados) no la juzgan (WS-K13)."""
+    st = "enmendada"
+    for x in ev:
+        if x.get("ref") == eid and x["tipo"] in ("veredicto", "enmienda"):
+            st = estado_enmienda(x["id"], ev) if x["tipo"] == "enmienda" else x["estado"]
     return st
 
 
+def raiz_enmienda(eid, ids):
+    """Sube por la cadena de enmiendas hasta el evento enmendado (la prediccion)."""
+    x = ids.get(eid, {})
+    while x.get("tipo") == "enmienda":
+        x = ids.get(x.get("ref"), {})
+    return x
+
+
+def juzgada(pid, ev):
+    """La prediccion `pid` tiene veredicto, directo o sobre CUALQUIER enmienda de su
+    cadena (enmiendas de enmiendas incluidas)."""
+    cadena, front = {pid}, {pid}
+    while front:
+        front = {x["id"] for x in ev if x.get("tipo") == "enmienda" and x.get("ref") in front} - cadena
+        cadena |= front
+    return any(x.get("tipo") == "veredicto" and x.get("ref") in cadena for x in ev)
+
+
