+        ! Volumen (m3/s, el del TRANSPORTE) que la cara con caudal de Poisson q
+        ! (> 0 entra) mueve en la celda del lecho (i,j,k): el transporte usa
+        ! G = q rho_media/a_f por alpha del DADOR y lo divide por la rho de la
+        ! celda (conservative_noalpha). Entradas completas; salidas escaladas
+        ! por el s de la receptora
+        subroutine acc_face(q, inb, jnb, knb, a_f, s_nb, qin, qout)
+            real(dp), intent(in)    :: q, a_f, s_nb
+            integer, intent(in)     :: inb, jnb, knb
+            real(dp), intent(inout) :: qin, qout
+            real(dp) :: rbar, fac
+            rbar = 0.5_dp * (liq%rho(i,j,k) + liq%rho(inb,jnb,knb))
+            if (q > 0.0_dp) then
+                fac = 1.0_dp
+                if (a_f > SMALL) fac = liq%alpha(inb,jnb,knb) / a_f * rbar / max(liq%rho(i,j,k), SMALL)
+                qin = qin + q * fac
+            else if (q < 0.0_dp) then
+                fac = 1.0_dp
+                if (a_f > SMALL) fac = liq%alpha(i,j,k) / a_f * rbar / max(liq%rho(i,j,k), SMALL)
+                qout = qout - q * fac * s_nb
+            end if
+        end subroutine acc_face
+
+        ! Cara lo|hi con caudal abierto q (> 0: de lo a hi): candidata a flujo
+        ! fijo si su receptora tiene s < 1 - pc_ai_tol, con Qf = s q
+        subroutine fix_face(q, s_lo, s_hi, fx, qf)
+            real(dp), intent(in)    :: q, s_lo, s_hi
+            real(dp), intent(inout) :: fx, qf
+            real(dp) :: sr
+            sr = 1.0_dp
+            if (q > 0.0_dp) then
+                sr = s_hi
+            else if (q < 0.0_dp) then
+                sr = s_lo
+            end if
+            if (sr < 1.0_dp - cfg%pc_ai_tol) then
+                fx = 1.0_dp; qf = sr * q
+            else
+                fx = 0.0_dp; qf = 0.0_dp
+            end if
+        end subroutine fix_face
+
+        ! Saca de la fila la conductancia de liquido de una cara de flujo fijo
+        ! (coeficiente de vecino y su parte de aP, con la compliance) y pone
+        ! la diferencia de caudal en la fuente
+        subroutine drop_face(anb, apc, suc, ac, dsu)
+            real(dp), intent(inout) :: anb, apc, suc
+            real(dp), intent(in)    :: ac, dsu
+            anb = anb - ac
+            apc = apc - ac * (1.0_dp + PP_COMPLIANCE)
+            suc = suc + dsu
+        end subroutine drop_face
+
