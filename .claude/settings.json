{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/estado_sesion.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_corridas.sh"
          },
          {
            "type": "command",
            "command": "d=\"${CLAUDE_PROJECT_DIR}\"; f=.claude/hooks/guard_cierre.sh; if s=$(git -C \"$d\" show \"HEAD:$f\" 2>/dev/null) && [ -n \"$s\" ]; then exec bash -c \"$s\"; fi; exec \"$d/$f\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_corridas.sh"
          },
          {
            "type": "command",
            "command": "d=\"${CLAUDE_PROJECT_DIR}\"; f=.claude/hooks/guard_cierre.sh; if s=$(git -C \"$d\" show \"HEAD:$f\" 2>/dev/null) && [ -n \"$s\" ]; then exec bash -c \"$s\"; fi; exec \"$d/$f\""
          }
        ]
      }
    ]
  }
}
