     ! (B1 v31, t = 113.5 s). C_FS_SHEAR = 1/2 C_D con C_D ~ 1.
     real(dp), parameter :: C_FS_SHEAR = 0.5_dp
 
+    ! --- F2.22 (29-sep-2026): AIAD de verdad, y MEZCLA en vez de interruptor.
+    !
+    ! Dos defectos de la forma anterior, ambos medidos en el colapso que
+    ! arranca cuando el arco perfora el lecho (ver docs/ARCHITECTURE.md):
+    !
+    ! (a) La eleccion de morfologia era un INTERRUPTOR DURO sobre alpha_s
+    !     (propio > 1e-4 o de abajo >= 1e-2). Al cruzarlo, K saltaba una
+    !     mediana de 1.5e8 veces. Ningun codigo Euler-Euler hace eso:
+    !     AIAD (Hoehne & Vallee, WIT Trans. Eng. Sci. 63 (2010) 123, ecs.
+    !     6-9) MEZCLA los coeficientes con una logistica
+    !         f = [1 + exp(a (alpha - alpha_lim))]^-1
+    !     y GENTOP (Haensch et al., Int. J. Multiphase Flow 47 (2012) 171)
+    !     con la tanh equivalente; ambos con alpha_lim = 0.3 y a = 50-70
+    !     (ancho 10-90 % de ln(81)/a ~ 0.06-0.09 en fraccion de volumen).
+    !     TRACE/RELAP interpolan sobre bandas de 0.2-0.3. Nunca un umbral.
+    !
+    ! (b) La cizalla usaba un C_D fijo en una ley CUADRATICA, y con
+    !     |grad alpha_l| como unica area daba K ~ 50 en malla media: nada.
+    !     AIAD define el arrastre de superficie libre como una FRICCION
+    !     (Hoehne & Mehlhoop, Int. J. Multiphase Flow 62 (2014) 1, ecs.
+    !     7-8; ANSYS Fluent Theory Guide 14.5.20, ecs. 14-465/14-470):
+    !         A_fs   = 2 alpha_l alpha_g |grad alpha_l - grad alpha_g|
+    !         C_D,fs = max(C_FS_FLOOR, 2 (alpha_l tau_l + alpha_g tau_g)
+    !                                    / (rho_l u_slip^2))
+    !         K      = C_D,fs A_fs (1/2) rho_mix |u_slip|
+    !     con tau_q = mu_eff_q |u_slip|/delta el esfuerzo de pared de la
+    !     capa limite a cada lado. El 1/u_slip^2 CANCELA la cuadratica: la
+    !     fuerza queda lineal en Delta u, que es lo que debe ser una
+    !     friccion. El max() es un PISO, no un techo.
+    real(dp), parameter :: ALPHA_AIAD_LIM = 0.3_dp   ! centro de la mezcla
+    real(dp), parameter :: A_AIAD         = 50.0_dp  ! pendiente (Fluent)
+    real(dp), parameter :: C_FS_FLOOR     = 0.01_dp  ! piso de C_D,fs (AIAD)
+
     ! Movilidad del gas en una celda (F2.16): fraccion de su balance de
