+        was = cont
         cont = liq_continuous(liq%alpha, sol%alpha_s)
-        klo = lbound(cont,3) + 1; khi = ubound(cont,3)
-        do k = khi, klo, -1
-            where (.not. cont(:,:,k) .and. m%cell_type(:,:,k) /= 0 &
