+    ! la celda de superficie castaneteaba entre continua y dispersa al cruzar
+    ! ALPHA_LIQ_CONT, y al pasar a dispersa su cara con el bano se desenlazaba
+    ! del Poisson (F1). El remedio de la literatura para el castaneteo es una
+    ! BANDA, no un vecino: una celda que ya era continua lo sigue siendo
+    ! mientras alpha_l >= ALPHA_LIQ_HYST. La memoria es el valor ENTRANTE de
+    ! `cont` (el del iterado externo anterior), por eso es intent(inout).
+    !---------------------------------------------------------------------------
     subroutine liquid_continuity_mask(liq, sol, m, cont)
         type(phase_t), intent(in) :: liq
