-            end where
-        end do
+        where (was .and. .not. cont .and. m%cell_type /= 0 &
+               .and. liq%alpha >= ALPHA_LIQ_HYST)
+            cont = .true.
+        end where
+        deallocate(was)
     end subroutine liquid_continuity_mask
 
