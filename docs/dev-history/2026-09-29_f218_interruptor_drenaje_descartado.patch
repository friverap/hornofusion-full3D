+                        divl = 0.0_dp
+                        af_ = 0.5_dp*(liq%alpha(i,j,k) + liq%alpha(i+1,j,k))
+                        divl = divl + af_*0.5_dp*(liq%ur(i,j,k)+liq%ur(i+1,j,k))*m%Ar(i,j,k)
+                        af_ = 0.5_dp*(liq%alpha(i,j,k) + liq%alpha(i-1,j,k))
+                        divl = divl - af_*0.5_dp*(liq%ur(i-1,j,k)+liq%ur(i,j,k))*m%Ar(i-1,j,k)
+                        af_ = 0.5_dp*(liq%alpha(i,j,k) + liq%alpha(i,j+1,k))
+                        divl = divl + af_*0.5_dp*(liq%uth(i,j,k)+liq%uth(i,j+1,k))*m%Ath(i,j,k)
