--- a/src/mod_constants.f90
+++ b/src/mod_constants.f90
@@ -263,16 +263,25 @@ contains
 
     !---------------------------------------------------------------------------
     ! El liquido de la celda es fase continua (momento propio + Poisson)?
-    ! Fuera del lecho: alpha_l >= ALPHA_LIQ_CONT. En el lecho (hay chatarra):
-    ! el umbral hidrodinamico ordinario (el arrastre de Ergun gobierna).
+    ! Regimen por SATURACION del volumen libre (F2.33, oct-2026):
+    !     S = alpha_l / (1 - alpha_s) >= ALPHA_LIQ_CONT   y   alpha_l >= ALPHA_FLOW_CUTOFF
+    ! Fuera del lecho (alpha_s = 0) es la regla de siempre (alpha_l >= 0.3).
+    ! Dentro del lecho, el liquido de bajo holdup es GOTEO: velocidad de
+    ! percolacion de Ergun, sin presion propia (modelo de balance de fuerzas
+    ! de la zona de goteo del alto horno: Gupta et al. ISIJ Int. 36 (1996) 32;
+    ! Chew, Zulli & Yu, ISIJ Int. 41 (2001) 1112 — "flows as discrete droplets
+    ! or rivulets, quickly achieving a steady average percolation velocity").
+    ! El poro SATURADO es fase continua tipo Darcy en el Poisson (Yagi, ISIJ
+    ! Int. 33 (1993) 619; Ugarte et al. 2024 resuelven el baño bajo la
+    ! chatarra como fase continua). Antes, en el lecho bastaba alpha_l >=
+    ! 0.01: un poro con 2 % de liquido entraba al acople P-V con
+    ! conductancias minimas y era la region de los cuatro mecanismos de
+    ! 280-370 s de B1 (dev-history 2026-09-29).
     !---------------------------------------------------------------------------
     pure elemental logical function liq_continuous(al, as)
         real(dp), intent(in) :: al, as
-        if (as >= 1.0e-2_dp) then
-            liq_continuous = (al >= ALPHA_FLOW_CUTOFF)
-        else
-            liq_continuous = (al >= ALPHA_LIQ_CONT)
-        end if
+        liq_continuous = (al >= ALPHA_FLOW_CUTOFF) .and. &
+                         (al >= ALPHA_LIQ_CONT * max(1.0_dp - as, 0.0_dp))
     end function liq_continuous
 
     ! Fraccion de liquido que cabe en la celda (F2.7): hueco menos el gas
