+        ! medio caudal de gas a traves de la superficie de un bano en reposo y
+        ! lo destruia (intento descartado, docs/dev-history F2.17).
+        pure subroutine vanish_face(isgas, aP_, aN_, wP, wN)
+            logical,  intent(in)  :: isgas
+            real(dp), intent(in)  :: aP_, aN_
