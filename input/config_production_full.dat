# =============================================================================
# config_production_full.dat — Corrida de producción EAF 3D
#
# Replica Ugarte et al. (2024) Materials 17(21), 5139
# Horno eléctrico de arco 130 t, corriente alterna trifásica
#
# FÍSICA COMPLETA:
#   - Flujo multifase (Euler-Euler): gas + líquido + sólido (Ergun)
#   - Energía (implícita) + fusión/solidificación
#   - Turbulencia k-ε
#   - Arco: Cassie-Mayr + MC radiación + impingement + Lorentz
#   - Radiación DO (Discrete Ordinates)
#   - Química: C + ½O₂ → CO (Maahs) + combustión secundaria CO → CO₂
#   - Transporte de especies CO / CO₂
#   - Escoria: modelo termico listo (DO, acople con bano, cede al acero) pero
#     APAGADA en esta colada: sin talon ni adiciones no hay escoria que formar
#   - Buoyancy de Boussinesq
#
# MALLA: 60 × 120 × 84 = 604,800 celdas
#
# MPI:
#   12 procs (M4 Pro, 12 núcleos): mpirun -n 12  → descomposición 1×4×3
#    8 procs (MacBook):             mpirun -n  8  → descomposición 1×4×2
#   16 procs (cluster):             mpirun -n 16  → descomposición 1×4×4
#
# TIEMPO TOTAL: t_final 7200 s (tap-to-tap de referencia: 5040 s)
#   dt_0 = 2 ms, adaptativo (CFL <= 1) entre 1 ms y 10 ms, max_outer 5: los
#   parametros de B1 (v34), los unicos validados con el modelo de dos fluidos
#   (B1 corrio con el codigo anterior a M8-2/M11/M12 y SIN escoria). dt_max
#   10 ms: el mayor paso fijo validado CON BANO (bath_test, bath_fill); con
#   pasos >= 50 ms el modelo se rompe y la banda 10-50 ms con bano no la
#   cubre ningun banco. En los bancos el lazo externo no converge en
#   max_outer (5) y el control de paso queda en dt_min (auditoria 13):
#   contar con ~7e6 pasos. Con los antiguos (dt_0 0.5 s, dt_min 10 ms)
#   bath_test y bath_fill se rompen en los primeros pasos (auditoria 12).
#   Diferencia con B1: max_inner_pres 50 / max_inner_mom 5 (B1: 20 / 3, los de
#   config_300s_borein); mas iteraciones internas, mismo regimen de paso.
#
# COSTO (auditoria 15, M15-5, estimacion): ~180-225 dias a 14 ranks en el
#   regimen actual (paso en dt_min); ver docs/RUNNING.md. Correr por segmentos.
#
# OUTPUT: con dt 1-2 ms son ~4-7e6 pasos: output_freq 50000 da ~70-140
#   snapshots HDF5 x ~250 MB (~417 B/celda medido; ~18-35 GB); audit.csv
#   cada 5 pasos ~1.4e6 filas (~2.7 GB); monitor cada 500. Con
#   audit_freq > 1 check_audit.py trata energy_balance y arc_budget como
#   INFORMATIVOS: el audit de produccion no es un gate.
#
# RUN:
#   mkdir -p output_prod2
#   mpirun -n 12 ./bin/eaf3d_mpi input/config_production_full.dat
# =============================================================================

# ============================================================
# MALLA  (Ugarte et al. Tabla 1: 603,288 ≈ 604,800 celdas)
# ============================================================
nr      = 60
ntheta  = 120
nz      = 84
stretch_r = 1.5
stretch_z = 1.5

# ============================================================
# GEOMETRÍA EAF 130 t  (Ugarte et al. Figura 1)
# ============================================================
R_shell  = 3.80
H_total  = 4.50
H_bowl   = 0.60
R_bowl   = 2.50
R_pcd    = 0.85
R_elec   = 0.30

# ============================================================
# INTEGRACIÓN TEMPORAL
#   Bore-in dura ~200 s (electrodo baja 2 m a 0.01 m/s)
#   Cubo 2 cargado en t=2100 s
#   Tap-to-tap: 5040 s
# ============================================================
# (auditoria 12, M12-2) parametros de paso de B1: el modelo de dos fluidos
# no es estable con pasos fijos >= 50 ms ni con dt_0 0.5 s / dt_min 10 ms
# (bath_test: presion en P_HYDRO_CAP y liquido a 14-31 m/s, tambien en el
# estado de la auditoria 8: es previo)
dt           = 0.002
dt_min       = 0.001
dt_max       = 0.01
cfl_max      = 1.0
t_final      = 7200.0
adaptive_dt  = true

# ============================================================
# ALGORITMO SIMPLE
# ============================================================
max_outer     = 5
max_inner_mom = 5
max_inner_pres= 50

alpha_u     = 0.3
alpha_p     = 0.7
alpha_T     = 0.7
alpha_k     = 0.5
alpha_eps   = 0.5

# ============================================================
# TOLERANCIAS DE CONVERGENCIA
# ============================================================
tol_cont   = 1.0e-4
tol_mom    = 1.0e-4
tol_energy = 1.0e-6
tol_turb   = 1.0e-4

# ============================================================
# PROPIEDADES MATERIALES  (Ugarte et al. Tabla 2)
# ============================================================
rho_steel  = 7500.0
T_solidus  = 1600.0
T_liquidus = 1809.0
cp_s       = 400.0
cp_l       = 696.4
h_fusion   = 247000.0
k_s        = 35.0
k_l        = 30.0
T_initial  = 300.0
T_ambient  = 300.0

# ============================================================
# FÍSICA ACTIVA — todos los módulos
# ============================================================
solve_flow       = true
solve_energy     = true
solve_melting    = true
solve_turb       = true
solve_radiation  = true
solve_chemistry  = true
solve_arc        = true
solve_multiphase = true

# ============================================================
# ARCO: FRACCIONES DE CALOR  (Ugarte et al. Tabla 3)
#   P_total = V × I ≈ 27.5 MW/electrodo (ver electrode_profile.dat)
#   P_rad  = 0.50 × P → depositado en superficie del scrap (kscrap_loop)
#   P_conv = 0.30 × P → distribuido en columna de gas (kscrap→ktip)
#   P_elec = 0.20 × P → punta del electrodo
#   arc_w  = 30 W  →  R_eq = 9 mΩ  →  P_arc ≈ 27.5 MW  ✓
# ============================================================
frac_rad  = 0.50
frac_conv = 0.30
frac_elec = 0.20
arc_w     = 30.0

# ============================================================
# ESCORIA (capa de escoria encima del scrap)
# ============================================================
# (oct-2026) escoria REACTIVADA con su modelo termico (A13-1 cerrado): la
# escoria densa emite/absorbe en la DO, se acopla con el bano de su celda o
# el de abajo (el mayor), solo intercepta la RADIACION del arco (el arco abre
# cavidad: P_elec/P_conv al metal) y CEDE al acero (el exceso bajo la
# interfaz la desplaza; slag_buoyancy la sube). Bancos: arc_slag (10 s: T_sl
# bajo T_l, clip ~0) y arc_melt_slag (escoria sobre lecho que funde).
# k_slag no tiene efecto (aviso del parser). B1 (Ugarte) sigue sin escoria.
solve_slag   = false
rho_slag     = 2800.0
cp_slag      = 1200.0
# k_slag sin efecto en el modelo (retirado: el parser avisa)
h_contact_sl = 1000.0
# (auditoria 17, M17-1) sin TALON no hay escoria liquida al arrancar en frio:
# 3.3 t de escoria a 300 K sobre la chatarra fria (alpha_sl 0.47 en la cima
# del lecho, ~91 % de la radiacion del MC) es un estado no fisico que ningun
# banco cubre. La escoria inicial va con el talon (heel_mass > 0: se coloca a
# heel_T); esta colada arranca sin talon -> sin escoria inicial. Y sin
# escoria inicial NO hay via que la cree (la oxidacion a FeO esta acotada por
# la escoria existente; las adiciones se descartan con aviso): por eso
# solve_slag false (dirigida de 147fad5). Para una colada CON escoria: talon
# (heel_mass, heel_T) y m_slag_init > 0, y solve_slag true.
m_slag_init  = 0.0

# ============================================================
# TRANSPORTE DE ESPECIES CO / CO₂
# ============================================================
solve_species   = true
Sc_t_species    = 0.7

# ============================================================
# CARGA (cubo 2 en t=2100 s)
# ============================================================
t_bucket2_charge = 2100.0

# ============================================================
# SALIDA
#   ver la cabecera (OUTPUT): dimensionado para ~7e6 pasos de 1 ms
# ============================================================
output_freq  = 50000
monitor_freq = 500
audit_freq   = 5
output_dir   = output_prod2
# (auditoria 16, M16-I2) por segmentos: wall_time_max un poco por debajo del
# limite del job (p. ej. 169200 = 47 h); 0 = sin limite. Ver docs/RUNNING.md
wall_time_max = 0
